# Copy to server/.env for local development, or /srv/gm/env on the EC2 server.

# 1 on your computer, 0 on the server
DJANGO_DEBUG=1
# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8002
# Where the SQLite database, uploaded photos and cache live (default: server/data)
#DJANGO_DATA_DIR=/srv/gm/data

# Google accounts allowed to administer the site (comma separated)
ADMIN_EMAILS=pfgm.soisy@gmail.com
# Who receives "message to approve" emails (defaults to ADMIN_EMAILS)
#MODERATION_EMAILS=

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Amazon SES SMTP (leave EMAIL_HOST empty to print emails in the console instead)
EMAIL_HOST=
#EMAIL_HOST=email-smtp.eu-west-3.amazonaws.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Pompes Funèbres et Marbrerie GM <noreply@gmfuneraire.fr>"

# Private messages (delivered, or failed and never resent) are deleted this many days after being received
PRIVATE_COMMENT_RETENTION_DAYS=30
# Public messages refused by an admin are deleted this many days after being received
REJECTED_COMMENT_RETENTION_DAYS=30

# S3 bucket for nightly backups of the database and photos (e.g. gmfuneraire-backups)
BACKUP_BUCKET=

# Actualités: daily copy of the Facebook Page / Instagram posts (README → "Actualités")
META_PAGE_ID=
# Long-lived Page access token (does not expire, but is revoked if the password changes)
META_PAGE_TOKEN=
META_GRAPH_VERSION=v23.0
# 1 = also import from the Instagram professional account linked to the Page
META_IMPORT_INSTAGRAM=1
# Posts containing this tag are not copied to the site
SOCIAL_OPT_OUT_TAG=#pasdesite
